	{
		src: '/images/Decker hd.jpg',
		caption: 'Decker and Erin: Anne Shannon & Erik Foster'
	},
	{
		src: '/images/Bristol hd2 .jpg',
		caption: 'Bristol and Symee: Deb Lewis'
	},
	{
		src: '/images/Tito 2023.jpg',
		caption: 'Tito: co-owner SuAn Schreuder'
	},
	{
		src: '/images/Rhea Hd small2.jpg',
		caption: 'Rhea and Eva: Brittany Pocotte'
	},
	{
		src: '/images/Bryce hd 3.jpg',
		caption: 'Bryce: Kim Crawford'
	},
	{
		src: '/images/Billee2.jpg',
		caption: 'Billee: Micki McMillian'
	},
	{
		src: '/images/Twist web.jpg',
		caption: 'Twist: Chris Robinson'
	},
	{
