---
import Page from '@components/page.astro';
import Image from '@components/image.astro';
---

<Page title="Upcoming Litters" description="See upcoming litters">
	<h1 class="h1 text-center"> Upcoming Litters </h1>
	<p class="text-center">
		Our upcoming plans for 2026/27. Moxi will be bred at the end of 2026.
    Savvy will be bred first part or mid-2027 depending on how things shake out!
    Currently we have 9 people on our wait list for these 2 outstanding girls.
	</p>
	<div class="mt-6 flex justify-center flex-wrap gap-4">
		<a href="/contact" class="btn-primary"> Contact </a>
	</div>
	<!-- Meet the Parents -->
	<h2 class="h2 text-center mt-10"> Meet the Parents! </h2>
	<h3 class="h3 mt-10"> Moxi will be bred to Cory in late 2026 - early 2027 </h3>
	<div class="flex flex-col gap-4">
		<div class="flex flex-col gap-4 md:flex-row">
			<Image class="basis-3/5" aspectRatio="aspect-3/2" src="/images/puppies/Moxi-3.jpg" caption="Read more about <a href='/dogs/moxi'> Moxi</a>" />
			<Image class="basis-2/5" aspectRatio="aspect-square" src="/images/puppies/Moxi-Megan.jpg" />
		</div>
		<div class="flex flex-col gap-4 md:flex-row">
			<Image class="basis-2/5" aspectRatio="aspect-square" src="/images/puppies/Corey-head.jpg" />
			<Image class="basis-3/5" aspectRatio="aspect-3/2" src="/images/puppies/Cory-2.jpg" caption="Cressida Quiet Nights of Quiet Stars UD RE AX AXJ VSWE CCA 'Cory'" />
		</div>
	</div>
	<h3 class="h3 mt-10"> Savvy will be bred to Nathan early 2027 </h3>
	<div class="flex flex-col gap-4">
		<div class="flex flex-col gap-4 md:flex-row">
			<Image class="basis-3/5" aspectRatio="aspect-3/2" src="/images/puppies/Moxi-3.jpg" caption="Read more about <a href='/dogs/savvy'> Savvy</a>" />
			<Image class="basis-2/5" aspectRatio="aspect-square" src="/images/puppies/Moxi-Megan.jpg" />
		</div>
		<div class="flex flex-col gap-4 md:flex-row">
			<Image class="basis-2/5" aspectRatio="aspect-square" src="/images/puppies/Corey-head.jpg" />
			<Image class="basis-3/5" aspectRatio="aspect-3/2" src="/images/puppies/Cory-2.jpg" caption="Ch Crystal Glen Odds On Favorite CD 'Nathan'" />
		</div>
	</div>

</Page>
