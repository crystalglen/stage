---
const { alt } = Astro.props;
const hasAlt = typeof alt === 'string' && alt.length > 0;
---
<div class='grid gap-6 grid-cols-1 md:grid-cols-2 md:gap-12 items-center'>
  <div>
    <slot/>
  </div>
  <div>
    <img src={Astro.props.src} alt={hasAlt ? Astro.props.alt : null} role={!hasAlt ? 'presentation' : null} />
  </div>
</div>